<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>tws_login_win</RootNamespace>
        <AssemblyName>tws-login-win</AssemblyName>
        <TargetFramework>net10.0-windows</TargetFramework>
        <!-- TWS ships only the 64-bit Java Access Bridge DLL. -->
        <PlatformTarget>x64</PlatformTarget>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <Version>0.1.0</Version>
        <Product>tws-login-win</Product>
        <Description>Logs Interactive Brokers Trader Workstation in through the Java Access Bridge. Not affiliated with Interactive Brokers.</Description>
        <Copyright>Copyright (c) 2026 John Clayton</Copyright>

        <!-- Release builds: one self-contained exe, no .NET install needed. Not trimmed: the bridge's P/Invoke
             marshalling and System.Text.Json are not verified trim-safe. -->
        <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
        <RuntimeIdentifier Condition="'$(_IsPublishing)' == 'true'">win-x64</RuntimeIdentifier>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>embedded</DebugType>
        <!-- No local paths in the binary, and the same source gives the same build. -->
        <Deterministic>true</Deterministic>
        <PathMap>$(MSBuildProjectDirectory)=/src/tws-login-win</PathMap>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="tws-login-win.Tests" />
    </ItemGroup>

</Project>
